{
  "name": "modu-pdf-reader",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "desktopName": "com.hzz2z.modureader",
  "description": "本地优先 PDF 深度阅读器",
  "author": "HZZ2Z <HZZ2Z@users.noreply.github.com>",
  "homepage": "https://github.com/HZZ2Z/Updf",
  "scripts": {
    "pdfjs:assets": "node scripts/sync-pdfjs-assets.mjs",
    "predev": "npm run pdfjs:assets",
    "dev": "next dev -H 127.0.0.1",
    "launch": "node scripts/start-modu.mjs",
    "prebuild": "npm run pdfjs:assets",
    "build": "next build",
    "prepare:desktop": "node scripts/prepare-desktop-runtime.mjs",
    "desktop:run": "npm run build && npm run prepare:desktop && electron .",
    "build:linux": "npm run build && npm run prepare:desktop && electron-builder --config electron-builder.yml --linux AppImage deb --x64",
    "verify:linux": "node scripts/verify-linux-package.mjs",
    "prestart": "npm run pdfjs:assets",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "latest",
    "electron-updater": "6.8.9",
    "lucide-react": "latest",
    "next": "latest",
    "page-flip": "latest",
    "pdfjs-dist": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
